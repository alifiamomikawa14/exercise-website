---
interface InfoItem {
  label: string;
  value: string;
  icon: "location" | "type" | "field" | "brand";
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  mainImage: string;
  thumbnails: string[];
  info: InfoItem[];
}

const {
  eyebrow = "PROYEK YANG TELAH KAMI KERJAKAN",
  title,
  description,
  mainImage,
  thumbnails,
  info,
} = Astro.props;
---

<div class="project-card">
  <div class="project-gallery">
    <div class="main-image">
      <img src={mainImage} alt={title} />
    </div>
    <div class="thumb-row">
      {
        thumbnails.map((thumb) => (
          <div class="thumb-item">
            <img src={thumb} alt={title} />
          </div>
        ))
      }
    </div>
  </div>

  <div class="project-info">
    <div class="info-eyebrow-block">
      <p class="project-eyebrow">{eyebrow}</p>
      <span class="eyebrow-underline"></span>
    </div>

    <div class="info-text-block">
      <h3 class="project-title">{title}</h3>
      <p class="project-desc">{description}</p>
    </div>

    <div class="info-grid">
      {
        info.map((item) => (
          <div class="info-item">
            <div class="info-icon">
              {item.icon === "location" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                  <path
                    d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"
                    fill="#2E86DE"
                  />
                  <circle cx="12" cy="10" r="2.5" fill="#fff" />
                </svg>
              )}
              {item.icon === "type" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                  <path
                    d="M4 20V9l4-3 4 3v11M12 20V6l4-3 4 3v14"
                    stroke="#2E86DE"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {item.icon === "field" && (
                <svg viewBox="0 0 64 64" width="20" height="20">
                  <rect x="10" y="34" width="44" height="10" rx="2" fill="#0D3B66" opacity="0.3" />
                  <rect x="12" y="26" width="40" height="10" rx="2" fill="#2E86DE" />
                  <rect x="14" y="18" width="36" height="10" rx="2" fill="#5DC8F5" />
                </svg>
              )}
              {item.icon === "brand" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                  <path
                    d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5l7-3z"
                    fill="#2E86DE"
                  />
                  <path
                    d="M9 12l2 2 4-4"
                    stroke="#fff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </div>
            <div class="info-text">
              <p class="info-label">{item.label}</p>
              <p class="info-value">{item.value}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>

  .project-card {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 40px;
    background: #fff;
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 8px 24px rgba(13, 30, 61, 0.06);
  }

  .project-gallery {
    grid-column: span 6;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 20px;
    height: 100%;
  }

  .main-image {
    border-radius: 16px;
    overflow: hidden;
    height: 100%;
  }

  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .thumb-item {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1.2 / 1;
  }

  .thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    grid-column: span 6;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    align-content: start;
  }

  .info-eyebrow-block,
  .info-text-block,
  .info-grid {
    grid-column: span 6;
  }

  .info-eyebrow-block {
    display: flex;
    flex-direction: column;
  }

  .project-eyebrow {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--color-primary-blue, #2e86de);
    margin: 0 0 12px;
  }

  .eyebrow-underline {
    display: block;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-primary-blue, #2e86de);
  }

  .info-text-block {
    display: flex;
    flex-direction: column;
  }

  .project-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    color: var(--color-primary-navy, #0d1e3d);
    margin: 0 0 12px;
  }

  .project-desc {
    font-family: var(--font-family-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary, #6b7a90);
    margin: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .info-item {
    grid-column: span 3;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid #e6edf5;
    border-radius: 14px;
  }

  .info-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #eaf3fc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-label {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 12px;
    color: var(--color-primary-navy, #0d1e3d);
    margin: 0 0 2px;
  }

  .info-value {
    font-family: var(--font-family-body);
    font-size: 10px;
    color: var(--color-text-secondary, #6b7a90);
    margin: 0;
  }

  @media (max-width: 900px) {
    .project-gallery,
    .project-info {
      grid-column: span 12;
    }
  }

  @media (max-width: 480px) {
    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-item {
      grid-column: span 1;
    }
  }
</style>