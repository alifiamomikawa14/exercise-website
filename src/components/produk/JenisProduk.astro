---
const categories = [
  {
    name: "Waterproofing Membrane",
    description: "Lapisan pelindung fleksibel untuk area basah dan atap.",
    icon: "membrane",
  },
  {
    name: "Waterproofing Coating",
    description: "Cairan pelapis anti bocor yang mudah diaplikasikan.",
    icon: "bucket",
  },
  {
    name: "Waterproofing Cement",
    description: "Campuran semen tahan air untuk struktur beton.",
    icon: "cement",
  },
  {
    name: "Roof Waterproofing",
    description: "Solusi khusus mencegah kebocoran pada atap rumah.",
    icon: "roof",
  },
  {
    name: "Repair & Grouting",
    description: "Material perbaikan dan pengisi celah/nat bangunan.",
    icon: "repair",
  },
  {
    name: "Sealant & Adhesive",
    description: "Perekat dan penyegel sambungan untuk kekedapan air.",
    icon: "tape",
  },
];
---

<section class="material-category">
  <div class="container">
    <div class="material-grid">
      {
        categories.map((item) => (
          <div class="category-card">
            <div class="icon-box">
              {item.icon === "membrane" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <rect x="10" y="34" width="44" height="10" rx="2" fill="#0D3B66" opacity="0.3" />
                  <rect x="12" y="26" width="40" height="10" rx="2" fill="#2E86DE" />
                  <rect x="14" y="18" width="36" height="10" rx="2" fill="#5DC8F5" />
                </svg>
              )}
              {item.icon === "bucket" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <path d="M16 22h32l-4 30a4 4 0 0 1-4 3.5H24a4 4 0 0 1-4-3.5L16 22z" fill="#2E86DE" />
                  <rect x="14" y="18" width="36" height="6" rx="3" fill="#1B5EA8" />
                  <path d="M22 18c0-5 4-9 10-9s10 4 10 9" fill="none" stroke="#1B5EA8" stroke-width="3" />
                  <path d="M32 30c-3 4-3 7 0 10 3-3 3-6 0-10z" fill="#BEE3F8" />
                </svg>
              )}
              {item.icon === "cement" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <path d="M18 14h28l4 8-6 30a4 4 0 0 1-4 3H24a4 4 0 0 1-4-3l-6-30 4-8z" fill="#2E86DE" />
                  <rect x="18" y="14" width="28" height="8" fill="#1B5EA8" />
                  <path d="M32 26c-3 4-3 7 0 10 3-3 3-6 0-10z" fill="#BEE3F8" />
                  <circle cx="40" cy="46" r="5" fill="#0D3B66" opacity="0.35" />
                  <circle cx="46" cy="42" r="4" fill="#0D3B66" opacity="0.25" />
                </svg>
              )}
              {item.icon === "roof" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <path d="M32 12 8 30v4h6v20h36V34h6v-4L32 12z" fill="#2E86DE" />
                  <path d="M32 12 8 30v4h6l18-14 6 4.5V16z" fill="#1B5EA8" />
                  <path d="M32 34c-3 4-3 7 0 10 3-3 3-6 0-10z" fill="#BEE3F8" />
                </svg>
              )}
              {item.icon === "repair" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <circle cx="30" cy="16" r="5" fill="#2E86DE" />
                  <path d="M22 24c4-2 10-2 14 1l6 5-4 5-6-4c-3 3-6 8-6 12H12c1-9 5-15 10-19z" fill="#2E86DE" />
                  <rect x="38" y="40" width="16" height="5" rx="2" fill="#1B5EA8" transform="rotate(-20 38 40)" />
                  <rect x="10" y="46" width="14" height="4" rx="2" fill="#1B5EA8" />
                </svg>
              )}
              {item.icon === "tape" && (
                <svg viewBox="0 0 64 64" class="cat-icon">
                  <circle cx="30" cy="28" r="18" fill="#2E86DE" />
                  <circle cx="30" cy="28" r="8" fill="#0D3B66" />
                  <path d="M44 34c4 3 6 8 4 13l-8-5 4-8z" fill="#1B5EA8" />
                </svg>
              )}
            </div>
            <div class="cat-text">
              <h3 class="cat-title">{item.name}</h3>
              <p class="cat-desc">{item.description}</p>
              <span class="cat-underline"></span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .material-category {
    padding-block: 25px;
  }

  .material-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
  }

  .category-card {
    grid-column: span 4;
    display: flex;
    align-items: center;
    gap: 20px;
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 16px rgba(13, 30, 61, 0.06);
  }

  .icon-box {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    border-radius: 16px;
    background: #eaf3fc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cat-icon {
    width: 42px;
    height: 42px;
  }

  .cat-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cat-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    color: var(--color-primary-navy, #0d1e3d);
    margin: 0;
  }

  .cat-desc {
    font-family: var(--font-family-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-secondary, #6b7a90);
    margin: 0;
  }

  .cat-underline {
    display: block;
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-light-blue, #22c1c3);
    margin-top: 2px;
  }

  @media (max-width: 1024px) {
    .category-card {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .category-card {
      grid-column: span 12;
    }
  }
</style>