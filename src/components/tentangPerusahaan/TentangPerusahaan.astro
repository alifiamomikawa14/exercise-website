---
interface InfoCard {
  label: string;
  value: string;
  description: string;
  icon: "calendar" | "target" | "gear" | "tag";
}

interface Props {
  title: string;
  subtitle: string;
  cards: InfoCard[];
}

const { title, subtitle, cards } = Astro.props;
---

<section class="tentang-section">
  <div class="container">
    <div class="tentang-header">
      <h2 class="tentang-title">{title}</h2>
      <span class="tentang-underline"></span>
      <p class="tentang-subtitle">{subtitle}</p>
    </div>

    <div class="tentang-grid">
      {cards.map((card) => (
        <div class="info-card">
          <div class="info-icon">
            {card.icon === "calendar" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <rect x="3" y="5" width="18" height="16" rx="2" stroke="#2563EB" stroke-width="1.6" />
                <path d="M3 9h18" stroke="#2563EB" stroke-width="1.6" />
                <path d="M8 3v4M16 3v4" stroke="#2563EB" stroke-width="1.6" stroke-linecap="round" />
                <rect x="7" y="12" width="4" height="4" rx="1" fill="#2563EB" />
              </svg>
            )}
            {card.icon === "target" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <circle cx="12" cy="12" r="9" stroke="#2563EB" stroke-width="1.6" />
                <circle cx="12" cy="12" r="5" stroke="#2563EB" stroke-width="1.6" />
                <circle cx="12" cy="12" r="1.5" fill="#2563EB" />
              </svg>
            )}
            {card.icon === "gear" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <circle cx="12" cy="12" r="3" stroke="#2563EB" stroke-width="1.6" />
                <path
                  d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"
                  stroke="#2563EB"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            )}
            {card.icon === "tag" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <path
                  d="M20 12l-8 8-9-9V4h7l10 10z"
                  stroke="#2563EB"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <circle cx="8" cy="8" r="1.3" fill="#2563EB" />
              </svg>
            )}
          </div>

          <p class="info-label">{card.label}</p>
          <p class="info-value">{card.value}</p>
          <p class="info-desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tentang-section {
    padding-block: var(--space-16);
  }

  .tentang-header {
    margin-bottom: var(--space-10);
  }

  .tentang-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 28px;
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-3);
  }

  .tentang-underline {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    width: 60px;
    height: 3px;
    background: var(--color-primary-navy);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-4);
    position: relative;
  }

  .tentang-underline::after {
    content: "";
    position: absolute;
    left: 68px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-navy);
    box-shadow: 10px 0 0 var(--color-primary-navy);
  }

  .tentang-subtitle {
    font-family: var(--font-family-body);
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .tentang-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-01);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-light-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .info-label {
    font-family: var(--font-family-body);
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1);
  }

  .info-value {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-3);
    line-height: 1.3;
  }

  .info-desc {
    font-family: var(--font-family-body);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .tentang-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tentang-grid {
      grid-template-columns: 1fr;
    }
  }
</style>