---
<section class="hero">
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-inner">
      <p class="hero-eyebrow">SOLUSI MATERIAL KONSTRUKSI</p>
      <h1 class="hero-title">Material Terpercaya,<br />Solusi untuk Setiap Proyek</h1>
      <p class="hero-desc">
        Menyediakan material konstruksi berkualitas untuk mendukung
        perlindungan, ketahanan, dan keberhasilan setiap proyek.
      </p>
      <div class="hero-actions">
        <a href="/produk" class="btn btn-primary">Lihat Produk</a>
        <a
          href="https://wa.me/628584781067?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20produk%20material%20konstruksi."
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konsultasi dengan Kami
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    background: url('/public/images/Hero-Image.png') center/cover no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(13, 24, 61, 0.85) 0%,
      rgba(13, 24, 61, 0.55) 45%,
      rgba(13, 24, 61, 0.1) 75%
    );
  }

  .hero-container {
  position: relative;
  z-index: 1;
}

.hero-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;   /* rata kiri secara horizontal */
  justify-content: start;    /* konten mulai dari atas */
  max-width: 620px;
  text-align: left;
}
  .hero-eyebrow {
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-light-blue);
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.2;
    color: var(--color-white);
    margin: 0 0 var(--space-4);
  }

  .hero-desc {
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-background);
    margin: 0 0 var(--space-8);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
  }

  .btn {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 14px;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .btn-primary {
    background: var(--color-primary-blue);
    color: var(--color-white);
    border: 1px solid var(--color-primary-blue);
  }

  .btn-primary:hover {
    background: var(--color-blue);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-white);
    border: 1px solid var(--color-white);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 30px;
    }
    .hero-inner {
      max-width: 100%;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>