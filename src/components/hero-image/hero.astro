---
interface ButtonProps {
  text: string;
  href: string;
  variant?: "primary" | "outline";
  external?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  backgroundImage?: string;
  buttons?: ButtonProps[];
}

const {
  eyebrow,
  title,
  description,
  backgroundImage,
  buttons = [],
} = Astro.props;
---

<section class="hero" style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}>
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-inner">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <h1 class="hero-title" set:html={title} />
      {description && <p class="hero-desc">{description}</p>}

      {buttons.length > 0 && (
        <div class="hero-actions">
          {buttons.map((btn) => (
           <a 
              href={btn.href}
              class={`btn ${btn.variant === "outline" ? "btn-outline" : "btn-primary"}`}
              target={btn.external ? "_blank" : undefined}
              rel={btn.external ? "noopener noreferrer" : undefined}
            >
              {btn.text}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(13, 24, 61, 0.85) 0%,
      rgba(13, 24, 61, 0.55) 45%,
      rgba(13, 24, 61, 0.1) 75%
    );
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: start;
    max-width: 620px;
    text-align: left;
  }

  .hero-eyebrow {
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-light-blue);
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.2;
    color: var(--color-white);
    margin: 0 0 var(--space-4);
  }

  .hero-desc {
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-background);
    margin: 0 0 var(--space-8);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
  }

  .btn {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 14px;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .btn-primary {
    background: var(--color-primary-blue);
    color: var(--color-white);
    border: 1px solid var(--color-primary-blue);
  }

  .btn-primary:hover {
    background: var(--color-blue);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-white);
    border: 1px solid var(--color-white);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 30px;
    }
    .hero-inner {
      max-width: 100%;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>