---
interface SektorItem {
  title: string;
  description: string;
  image: string;
  icon: "building" | "factory" | "house" | "infrastructure";
}

interface Props {
  title: string;
  description: string;
  items: SektorItem[];
}

const { title, description, items } = Astro.props;
---

<section class="sektor-section">
  <div class="container">
    <div class="sektor-grid">
      <div class="sektor-content">
        <h2 class="sektor-title">{title}</h2>
        <span class="sektor-underline"></span>
        <p class="sektor-desc">{description}</p>
      </div>

      <div class="sektor-cards">
        {items.map((item) => (
          <div class="sektor-card">
            <div class="sektor-image">
              <img src={item.image} alt={item.title} />
              <div class="sektor-icon">
                {item.icon === "building" && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <rect x="4" y="3" width="16" height="18" rx="1" stroke="#fff" stroke-width="1.5" />
                    <path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                )}
                {item.icon === "factory" && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path
                      d="M4 21V11l5 3v-3l5 3v-3l5 3v7H4z"
                      stroke="#fff"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path d="M7 21v-4M12 21v-4M17 21v-4" stroke="#fff" stroke-width="1.5" />
                  </svg>
                )}
                {item.icon === "house" && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path d="M4 11l8-7 8 7v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9z" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
                    <path d="M10 21v-6h4v6" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
                  </svg>
                )}
                {item.icon === "infrastructure" && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path
                      d="M3 17c3-4 6-6 9-6s6 2 9 6"
                      stroke="#fff"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                    <path d="M6 21V13M18 21V13" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                )}
              </div>
            </div>

            <h3 class="sektor-card-title">{item.title}</h3>
            <p class="sektor-card-desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sektor-section {
    padding-block: var(--space-16);
  }

  .sektor-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .sektor-content {
    grid-column: span 3;
  }

  .sektor-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.3;
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-3);
  }

  .sektor-underline {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    width: 50px;
    height: 3px;
    background: var(--color-primary-navy);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-5);
    position: relative;
  }

  .sektor-underline::after {
    content: "";
    position: absolute;
    left: 58px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-navy);
    box-shadow: 8px 0 0 var(--color-primary-navy);
  }

  .sektor-desc {
    font-family: var(--font-family-body);
    font-size: var(--text-body-sm);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .sektor-cards {
    grid-column: span 9;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .sektor-card {
    display: flex;
    flex-direction: column;
  }

  .sektor-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .sektor-image img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    display: block;
  }

  .sektor-icon {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-2);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-primary-navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sektor-card-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-2);
  }

  .sektor-card-desc {
    font-family: var(--font-family-body);
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .sektor-content,
    .sektor-cards {
      grid-column: span 12;
    }

    .sektor-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .sektor-cards {
      grid-template-columns: 1fr;
    }
  }
</style>