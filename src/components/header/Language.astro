---
import {languageMenu} from "../../Data/Bahasa.ts"
---

<div class="language-switch has-dropdown">
  <button class="language-trigger" type="button" aria-label="Pilih bahasa">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <circle
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <path
        d="M2 12h20M12 2c2.5 2.5 4 5.5 4 10s-1.5 7.5-4 10c-2.5-2.5-4-5.5-4-10s1.5-7.5 4-10z"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>

    <span>{languageMenu.name}</span>

    <svg
      class="language-icon"
      width="10"
      height="6"
      viewBox="0 0 10 6"
      fill="none"
    >
      <path
        d="M1 1L5 5L9 1"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <div class="language-dropdown">
    <ul>
      {languageMenu.children.map((language) => (
        <li>
          <a
            href={language.href}
            class={
              "highlight" in language && language.highlight
                ? "language-active"
                : ""
            }
          >
            <span>{language.name}</span>

            {"highlight" in language && language.highlight && (
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8l3 3 7-7"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .language-switch {
    position: relative;
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .language-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border: none;
    background: transparent;
    padding: 0;
    font-family: var(--font-family-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }

  .language-icon {
    margin-left: var(--space-2);
    transition: transform 0.2s ease;
  }

  .language-switch:hover .language-icon {
    transform: rotate(180deg);
  }

  .language-dropdown {
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    min-width: 190px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-03);
    padding: var(--space-3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
    z-index: 50;
  }

  .language-switch:hover .language-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .language-dropdown ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .language-dropdown a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-family: var(--font-family-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
  }

  .language-dropdown a:hover {
    background: var(--color-light-blue);
    color: var(--color-primary-blue);
  }

  .language-dropdown .language-active {
    background: var(--color-light-blue);
    color: var(--color-primary-blue);
    font-weight: 600;
  }
</style>