---
import { navItems } from "../../Data/navLink.ts";
---

<nav class="main-nav" aria-label="Main navigation">
  <ul>
    {navItems.map((item) => (
        <li class={item.dropdown? "has-dropdown" : ""}>
            <a href={item.href}>
                {item.name}
                {item.dropdown && (
                   <svg class="dropdown-icon" width="10" height="6" viewBox="0 0 10 6" fill="none">
                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg> 
                )}
            </a>
        </li>
      ))}
  </ul>
</nav>

<style>
    .main-nav ul{
        display: flex;
        align-items: center;
        gap: 50px;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .main-nav a{
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-family: var(--font-family-body);
        font-weight: 600;
        font-size: 14px;
        color: var(--color-text);
        text-decoration: none;
    }
    .main-nav a:hover {
    color: var(--color-primary-blue);
    }
     .dropdown-icon {
        margin-left: var(--space-2); 
    }
</style>
