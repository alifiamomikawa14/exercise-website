---
interface FeatureItem {
  label: string;
  icon: "shield" | "gear" | "support";
}

interface BrandCard {
  logoImage: string;
  logoBg?: string;
  name: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  backgroundImage: string;
  features: FeatureItem[];
  brands: BrandCard[];
}

const { eyebrow, title, description, backgroundImage, features, brands } = Astro.props;
---

<section class="brand-section" style={`background-image: url('${backgroundImage}')`}>
  <div class="brand-overlay"></div>
  <div class="container brand-container">
    <div class="brand-grid">
      <div class="brand-content">
        <p class="brand-eyebrow">{eyebrow}</p>
        <h2 class="brand-title">{title}</h2>
        <span class="brand-underline"></span>
        <p class="brand-desc">{description}</p>

        <div class="feature-row">
          {features.map((feature) => (
            <div class="feature-item">
              <div class="feature-icon">
                {feature.icon === "shield" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                    <path
                      d="M12 3l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V6l7-3z"
                      fill="#fff"
                    />
                    <path d="M9 12l2 2 4-4" stroke="#0D3B66" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {feature.icon === "gear" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                    <circle cx="12" cy="12" r="3" stroke="#fff" stroke-width="1.6" />
                    <path
                      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"
                      stroke="#fff"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
                {feature.icon === "support" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                    <path d="M4 13v-1a8 8 0 0 1 16 0v1" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
                    <rect x="3" y="13" width="4" height="5" rx="2" fill="#fff" />
                    <rect x="17" y="13" width="4" height="5" rx="2" fill="#fff" />
                  </svg>
                )}
              </div>
              <p class="feature-label">{feature.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="brand-cards">
        {brands.map((brand) => (
          <div class="brand-card">
            <div class="brand-logo-box" style={`background:${brand.logoBg || "#FFFFFF"}`}>
              <img src={brand.logoImage} alt={brand.name} class="brand-logo-img" />
            </div>

            <div class="brand-card-body">
              <h3 class="brand-name">{brand.name}</h3>
              <span class="brand-name-underline"></span>
              <p class="brand-card-desc">{brand.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .brand-section {
    position: relative;
    padding-block: var(--space-16);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .brand-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(249, 251, 255, 0.92) 0%,
      rgba(249, 251, 255, 0.85) 35%,
      rgba(249, 251, 255, 0.3) 60%,
      rgba(249, 251, 255, 0.05) 100%
    );
  }

  .brand-container {
    position: relative;
    z-index: 1;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .brand-content {
    grid-column: span 6;
  }

  .brand-eyebrow {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: var(--text-body-sm);
    color: var(--color-primary-blue);
    margin: 0 0 var(--space-2);
  }

  .brand-title {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.3;
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-3);
  }

  .brand-underline {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    width: 60px;
    height: 3px;
    background: var(--color-primary-navy);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-5);
    position: relative;
  }

  .brand-underline::after {
    content: "";
    position: absolute;
    left: 68px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-navy);
    box-shadow: 10px 0 0 var(--color-primary-navy);
  }

  .brand-desc {
    font-family: var(--font-family-body);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-8);
    max-width: 460px;
  }

  .feature-row {
    display: flex;
    gap: var(--space-6);
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 120px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-primary-navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-label {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: var(--text-body-sm);
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
  }

  .brand-cards {
    grid-column: span 6;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
    align-items: stretch;
  }

  .brand-card {
    grid-column: span 3;
    display: grid;
    grid-template-rows: 1fr 1fr;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-03);
    overflow: hidden;
    height: 100%;
  }

  .brand-logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }

  .brand-logo-img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
    display: block;
  }

  .brand-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .brand-name {
    font-family: var(--font-family);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-primary-navy);
    margin: 0 0 var(--space-2);
  }

  .brand-name-underline {
    display: block;
    width: 28px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-navy);
    margin-bottom: var(--space-3);
  }

  .brand-card-desc {
    font-family: var(--font-family-body);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 900px) {
    .brand-content,
    .brand-cards {
      grid-column: span 12;
    }

    .feature-row {
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>